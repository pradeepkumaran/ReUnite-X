SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_PHOTO_BUCKET=case-photos
PHOTO_SIGNED_URL_TTL_SECONDS=900

ENVIRONMENT=development
DEBUG=true
PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

AI_MODEL_NAME=facenet-512
INSIGHTFACE_MODEL_NAME=buffalo_l
FACE_MATCH_THRESHOLD=0.65
DUPLICATE_CHECK_THRESHOLD=0.90
WEIGHT_FACE=0.60
WEIGHT_AGE_GENDER=0.15
WEIGHT_LOCATION=0.15
WEIGHT_DESCRIPTION=0.10
MAX_MATCH_DISTANCE_KM=500
MAX_MATCH_AGE_DAYS=60
MIN_FACE_SIZE_PX=80
MIN_FACE_SHARPNESS=35

RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=alerts@example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
