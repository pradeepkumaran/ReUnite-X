# ============================================================================
# REUNITE-X Root Environment Variables Configuration Template
# ============================================================================

# --- Supabase Backend & Database Config ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-super-secret-jwt-signing-secret
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- Backend API Settings ---
ENVIRONMENT=development
PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://reunite-x.vercel.app"]

# --- AI Face Matching Parameters ---
AI_MODEL_NAME=facenet-512
FACE_MATCH_THRESHOLD=0.65
DUPLICATE_CHECK_THRESHOLD=0.90
WEIGHT_FACE=0.60
WEIGHT_AGE_GENDER=0.15
WEIGHT_LOCATION=0.15
WEIGHT_DESCRIPTION=0.10

# --- Maps Provider (Swappable: "mapbox" or "google") ---
VITE_MAP_PROVIDER=mapbox
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJjbGV4YW1wbGUifQ...
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# --- Push & Email Notifications ---
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"reunite-x"...}
RESEND_API_KEY=re_123456789
NOTIFICATION_FROM_EMAIL=alerts@reunite-x.org
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_123456789
